# Copier ce fichier en ".env" et adapter les valeurs

PORT=3000
NODE_ENV=production
SESSION_SECRET=change-moi-avec-une-longue-chaine-aleatoire

# Base de donnees (SQLite par defaut - fichier local, aucune config requise)
DB_STORAGE=./data/database.sqlite

# Compte admin cree automatiquement au premier demarrage (npm run seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-moi-1234
ADMIN_NAME=Administrateur

# Frais du service (modifiable aussi depuis l'admin plus tard)
DEFAULT_SERVICE_FEE_PERCENT=15
DEFAULT_SHIPPING_PRICE_PER_KG_KMF=3500

# Devise d'affichage
CURRENCY=KMF
